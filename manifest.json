{
  "manifest_version": 3,
  "name": "I/O Announcements Tracker",
  "description": "All 18 Google I/O 2026 announcements — filter by category, track what you've read, get a Gemini developer summary",
  "version": "1.0.0",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "32": "icons/icons32.png" }
  },
  "icons": { "32": "icons/icons32.png" },
  "background": { "service_worker": "background.js" },
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*"
  ]
}
